{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clienthub.local/contracts/v1/source.schema.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ],
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "ref_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "EMAIL",
        "CHAT",
        "MEETING"
      ],
      "minLength": 1
    },
    "provider_instance_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "external_source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "title": {
      "type": "string",
      "minLength": 0,
      "maxLength": 300
    },
    "occurred_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "actor_kind": {
      "type": "string",
      "enum": [
        "CLIENT",
        "INTERNAL",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "retention_mode": {
      "type": "string",
      "enum": [
        "METADATA_ONLY",
        "APPROVED_NOTES",
        "PERMITTED_CONTENT"
      ],
      "minLength": 1
    },
    "approved_notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "occurred_at_precision": {
      "type": "string",
      "enum": [
        "INSTANT",
        "DATE",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "visibility_class": {
      "type": "string",
      "enum": [
        "PROJECT_MEMBERS",
        "PO_PM_ONLY"
      ]
    },
    "permitted_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "ref_id",
    "project_id",
    "source_type",
    "provider_instance_key",
    "external_source_id",
    "occurred_at",
    "ingested_at",
    "actor_kind",
    "retention_mode",
    "observed_at",
    "visibility_class"
  ]
}

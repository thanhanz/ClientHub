{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clienthub.local/contracts/v1/context-bundle.schema.json",
  "title": "Context Bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ],
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_tickets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_external_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        }
      },
      "required": [
        "max_depth",
        "max_tickets",
        "max_external_calls"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traversal_depth_reached": {
          "type": "integer",
          "minimum": 0
        },
        "tickets_retrieved": {
          "type": "integer",
          "minimum": 0
        },
        "external_calls_used": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "traversal_depth_reached",
        "tickets_retrieved",
        "external_calls_used"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "source.schema.json"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "events": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "event.schema.json"
          },
          {
            "properties": {
              "review_status": {
                "const": "APPROVED"
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "event_ticket_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_ref": {
            "type": "string",
            "minLength": 4,
            "maxLength": 256
          },
          "jira_ref": {
            "type": "string",
            "minLength": 4,
            "maxLength": 256
          },
          "mapping_id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "relationship_type": {
            "type": "string",
            "enum": [
              "ADDRESSES_REPORTED_ISSUE",
              "IMPLEMENTS_REQUEST",
              "HAS_REQUESTED_DEADLINE_FOR",
              "COMMITMENT_COVERS_WORK",
              "RELATED_TO"
            ],
            "minLength": 1
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "CONFIRMED"
            ],
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "AI_INFERRED",
              "MANUAL",
              "EXPLICIT_REFERENCE",
              "TICKET_CREATED_FROM_EVENT"
            ],
            "minLength": 1
          }
        },
        "required": [
          "event_ref",
          "jira_ref",
          "mapping_id",
          "relationship_type",
          "verification_status",
          "origin"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 4,
            "maxLength": 256
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "jira_instance_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "issue_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "observed_at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "assignee_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "description_excerpt": {
            "$ref": "#/$defs/jira_excerpt"
          },
          "history": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/jira_excerpt"
            }
          },
          "comments": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/jira_excerpt"
            }
          }
        },
        "required": [
          "ref_id",
          "project_id",
          "jira_instance_key",
          "issue_key",
          "summary",
          "status",
          "observed_at"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    },
    "jira_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 4,
            "maxLength": 256
          },
          "jira_instance_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "from_issue_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "to_issue_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "relation_type": {
            "type": "string",
            "enum": [
              "BLOCKS",
              "BLOCKED_BY",
              "PARENT_OF",
              "CHILD_OF",
              "RELATES_TO"
            ],
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "JIRA_EXPLICIT_LINK"
            ],
            "minLength": 1
          }
        },
        "required": [
          "ref_id",
          "jira_instance_key",
          "from_issue_key",
          "to_issue_key",
          "relation_type",
          "observed_at",
          "source"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "evidence_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 4,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "enum": [
              "SOURCE",
              "EVENT",
              "JIRA_ISSUE",
              "JIRA_LINK",
              "JIRA_EXCERPT"
            ],
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "observed_at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "PENDING_REVIEW",
              "APPROVED",
              "REJECTED"
            ],
            "minLength": 1
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "MEETING_LEVEL",
              "APPROVED_NOTES",
              "MESSAGE_LEVEL",
              "JIRA_FIELD",
              "JIRA_EXPLICIT_LINK",
              "JIRA_EXCERPT"
            ],
            "minLength": 1
          }
        },
        "required": [
          "ref_id",
          "kind",
          "project_id"
        ]
      },
      "minItems": 0,
      "maxItems": 1500
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 100
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "question",
    "generated_at",
    "policy",
    "usage",
    "sources",
    "events",
    "event_ticket_links",
    "tickets",
    "jira_links",
    "evidence_registry",
    "warnings",
    "truncated"
  ],
  "$defs": {
    "jira_excerpt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref_id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ref_id",
        "text",
        "observed_at"
      ]
    }
  }
}
